# Required application settings
DATABASE_URL=postgresql://user:password@host:5432/database
SECRET_KEY=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379/0

# Hostinger SMTP. Keep EMAIL_ENABLED=false until the mailbox and DNS are ready.
EMAIL_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=no-reply@topchefeg.com
SMTP_PASSWORD=replace-with-the-mailbox-password
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=no-reply@topchefeg.com
EMAIL_FROM_NAME=Top Chef
SUPPORT_EMAIL=support@topchefeg.com

# Retained integrations are disabled by default. WhatsApp order notifications
# remain separately controlled by WHATSAPP_OUTBOX_ENABLED.
WHATSAPP_VERIFICATION_ENABLED=false
META_AGENT_ENABLED=false

# Alternative Hostinger connection if port 465 is unavailable:
# SMTP_PORT=587
# SMTP_SECURITY=starttls
